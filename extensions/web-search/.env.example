# Brave Search API key for the web_search tool.
#
# 1. Get a key: https://api-dashboard.search.brave.com/
# 2. Copy this file to `.env` in this same folder (it is git-ignored — this repo is public).
# 3. Paste the key below.
#
# A real BRAVE_API_KEY already in the environment wins over this file.
#
# A value beginning with `!` is run as a command and its output used as the key,
# so the key can live in your keychain rather than on disk:
#
#   BRAVE_API_KEY=!security find-generic-password -s brave-search -w
#
# It is run once per session, not once per search. Write `$!` for a key that
# really does start with an exclamation mark.

BRAVE_API_KEY=
